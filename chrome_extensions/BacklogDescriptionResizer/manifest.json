{
  "manifest_version": 3,
  "name": "Backlog Description Resizer",
  "version": "1.0",
  "description": "Resize description area on Backlog edit page",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.backlog.jp/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
